{
  "expo": {
    "name": "SUWA",
    "slug": "app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "SUWA usa la cámara para identificar tu planta al escanearla.",
        "NSPhotoLibraryUsageDescription": "SUWA necesita acceso a tus fotos para que puedas elegir una imagen ya tomada al escanear una planta."
      }
    },
    "android": {
      "package": "com.suwa.app",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "SUWA usa la cámara para identificar tu planta al escanearla."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SUWA necesita acceso a tus fotos para que puedas elegir una imagen ya tomada al escanear una planta."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "0a7be764-e5e4-46a9-9cb3-1dcf8be92b02"
      }
    }
  }
}
